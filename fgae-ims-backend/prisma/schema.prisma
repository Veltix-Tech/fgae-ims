generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

// CHANGED (Step 2): was PENDING_ACTIVATION / ACTIVE / DISABLED
enum UserStatus {
  INVITED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SubmissionChannel {
  PUBLIC
  STAFF_ASSISTED
}

// CHANGED (Step 2): was AWAITING_PAYMENT / REGISTERED / CANCELLED
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum NotificationType {
  PAYMENT
  REGISTRATION
  ACCOUNT_INVITATION
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// NEW (Step 2)
enum Gender {
  MALE
  FEMALE
}

// NEW (Step 2)
enum UnitType {
  HEAD_OFFICE
  AREA_OFFICE
  BRANCH
  HEALTH_FACILITY
}

// NEW (Step 2)
enum UnitStatus {
  ACTIVE
  INACTIVE
}

// ==========================================
// ORGANIZATION  (NEW, Step 3)
// ==========================================

model OrganizationUnit {
  id     String     @id @default(uuid()) @db.Uuid
  name   String     @db.VarChar(100)
  code   String     @unique @db.VarChar(20)
  type   UnitType
  status UnitStatus @default(ACTIVE)

  // Self-relation: parentId is the real column, parent/children are Prisma helpers
  parentId String?             @db.Uuid
  parent   OrganizationUnit?   @relation("UnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children OrganizationUnit[]  @relation("UnitHierarchy")

  // Back-relations required by other models
  userRoles    UserRole[]
  homeUsers    User[]                 @relation("UserPrimaryUnit")
  applications VolunteerApplication[] @relation("ApplicationPreferredBranch")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([parentId])
}

// ==========================================
// USER AND ROLE MANAGEMENT
// ==========================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(254)
  name         String?
  passwordHash String?
  status       UserStatus @default(INVITED) // CHANGED: default INVITED (still open with leader)

  // CHANGED (Step 7): required and unique, every user belongs to one person
  personId String @unique @db.Uuid
  person   Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  // NEW (Step 7): home office
  primaryUnitId String?           @db.Uuid
  primaryUnit   OrganizationUnit? @relation("UserPrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: Restrict)

  // NEW (Step 7)
  lastLoginAt DateTime? @db.Timestamptz(3)

  // REMOVED (Step 7): roleId, role  ->  replaced by userRoles
  sessions  Session[]
  userRoles UserRole[]

  submittedApplications VolunteerApplication[] @relation("ApplicationSubmitter")
  decidedApplications   VolunteerApplication[] @relation("ApplicationDecider")

  updatedSettings SystemSetting[] @relation("SettingUpdater")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([primaryUnitId])
}

// NEW (Step 4): one row per active login on a device
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  ipAddress String?   @db.VarChar(45)
  userAgent String?   @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // CHANGED (Step 7): users User[] replaced by userRoles
  userRoles   UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// NEW (Step 5): a user holds a role at a specific office
model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  unitId String @db.Uuid

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  unit OrganizationUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId, unitId])
  @@index([roleId])
  @@index([unitId])
}

// ==========================================
// PERSON
// ==========================================

model Person {
  id              String    @id @default(uuid()) @db.Uuid
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  grandFatherName String?   @db.VarChar(50)        // NEW (Step 6)
  gender          Gender                           // NEW (Step 6)
  email           String?   @unique @db.VarChar(254) // CHANGED: optional + unique
  phone           String    @unique @db.VarChar(30)  // CHANGED: unique
  dateOfBirth     DateTime? @db.Date                 // CHANGED: optional

  application VolunteerApplication?
  volunteer   Volunteer?
  user        User?

  notifications Notification[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // REMOVED (Step 6): @@index([email]) and @@index([phone]), unique already indexes them
}

// ==========================================
// VOLUNTEER APPLICATION
// ==========================================

model VolunteerApplication {
  id       String @id @default(uuid()) @db.Uuid
  personId String @unique @db.Uuid

  availability Json?

  submissionChannel SubmissionChannel
  submittedByUserId String?           @db.Uuid

  status      ApplicationStatus @default(SUBMITTED) // CHANGED: default SUBMITTED
  submittedAt DateTime          @default(now()) @db.Timestamptz(3)

  // NEW (Step 8): preferred branch and manager decision
  preferredBranchId String?   @db.Uuid
  decidedById       String?   @db.Uuid
  decisionNote      String?
  decidedAt         DateTime? @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)

  submittedBy User? @relation("ApplicationSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  preferredBranch OrganizationUnit? @relation("ApplicationPreferredBranch", fields: [preferredBranchId], references: [id], onDelete: Restrict)
  decidedBy       User?             @relation("ApplicationDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  payments Payment[]

  applicationSkills    ApplicationSkill[]
  applicationInterests ApplicationInterest[]

  volunteer Volunteer?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, submittedAt])
  @@index([submittedByUserId])
  @@index([personId])
  @@index([preferredBranchId]) // NEW
  @@index([decidedById])       // NEW
}

// ==========================================
// PAYMENT  (unchanged for now, updated in Phase 3)
// ==========================================

model Payment {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid

  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("ETB") @db.VarChar(3)
  status   PaymentStatus @default(PENDING)

  // Telebirr transaction information
  transactionReference String? @unique
  paymentReference     String  @unique

  // Phone number used for this payment attempt
  applicantPhone String? @db.VarChar(30)

  failureReason String?

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  verifiedAt DateTime? @db.Timestamptz(3)

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, status])
  @@index([createdAt])
}

// ==========================================
// VOLUNTEER  (unchanged for now, updated in Phase 2)
// ==========================================

model Volunteer {
  id            String @id @default(uuid()) @db.Uuid
  personId      String @unique @db.Uuid
  applicationId String @unique @db.Uuid

  volunteerNumber String @unique @db.VarChar(50)

  registeredAt DateTime @default(now()) @db.Timestamptz(3)

  person      Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  skills    VolunteerSkill[]
  interests VolunteerInterest[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// ==========================================
// NOTIFICATION
// ==========================================

model Notification {
  id       String @id @default(uuid()) @db.Uuid
  personId String @db.Uuid

  type    NotificationType
  message String             @db.Text
  status  NotificationStatus @default(PENDING)

  sentAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, status])
}

// ==========================================
// SKILLS
// ==========================================

model Skill {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  applications ApplicationSkill[]
  volunteers   VolunteerSkill[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Skills selected during application
model ApplicationSkill {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  skillId       String @db.Uuid

  proficiencyLevel ProficiencyLevel?

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  skill       Skill                @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([applicationId, skillId])
  @@index([skillId])
}

// Skills associated with registered volunteers
model VolunteerSkill {
  id          String @id @default(uuid()) @db.Uuid
  volunteerId String @db.Uuid
  skillId     String @db.Uuid

  proficiencyLevel ProficiencyLevel

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([volunteerId, skillId])
}

// ==========================================
// INTERESTS
// ==========================================

model Interest {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  applications ApplicationInterest[]
  volunteers   VolunteerInterest[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Interests selected during application
model ApplicationInterest {
  id            String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  interestId    String @db.Uuid

  application VolunteerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interest    Interest             @relation(fields: [interestId], references: [id], onDelete: Restrict)

  @@unique([applicationId, interestId])
  @@index([interestId])
}

// Interests associated with registered volunteers
model VolunteerInterest {
  id          String @id @default(uuid()) @db.Uuid
  volunteerId String @db.Uuid
  interestId  String @db.Uuid

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  interest  Interest  @relation(fields: [interestId], references: [id], onDelete: Restrict)

  @@unique([volunteerId, interestId])
}

// ==========================================
// SYSTEM SETTINGS
// ==========================================

model SystemSetting {
  id String @id @default(uuid()) @db.Uuid

  settingKey   String @unique
  settingValue String

  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  updatedByUserId String? @db.Uuid

  updatedBy User? @relation("SettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}
