# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=
DIRECT_URL=

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret

# Frontend origins (comma-separated, exact origins, no trailing slash)
CORS_ORIGINS=http://localhost:5173

# Refresh cookie
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
APP_BASE_URL=http://localhost:5173

# Reverse proxy: 1 when deployed behind one trusted proxy.
# Leave empty for local development without a reverse proxy.
TRUST_PROXY=